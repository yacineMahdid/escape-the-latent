{
  "name": "escape-the-latent",
  "version": "0.1.0",
  "private": true,
  "description": "A cozy paper-diorama game: you are a tiny human on a grumpy scientist's desk, sent into small paper worlds to bring back knowledge from famous ML papers.",
  "type": "module",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node server/test/run.mjs",
    "test:puzzles": "node test/puzzles/solve.cjs",
    "test:play": "node test/play/puzzles-ingame.cjs"
  },
  "engines": {
    "node": ">=18.17"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.4.0",
    "pdfjs-dist": "^4.10.38",
    "three": "^0.160.0"
  }
}
